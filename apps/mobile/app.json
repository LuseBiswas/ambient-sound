{
  "expo": {
    "name": "Ambient Monitor",
    "slug": "ambient-monitor",
    "version": "1.0.0",
    "scheme": "ambient-monitor",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "bundleIdentifier": "com.yourname.ambientmonitor",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone to stream ambient audio to your other devices.",
        "UIBackgroundModes": [
          "audio",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.yourname.ambientmonitor",
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/withKotlinVersion"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f676341f-f849-4c41-8809-e2a5fe785fbc"
      }
    }
  }
}
