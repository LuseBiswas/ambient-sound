PORT=3001
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=30d
# TURN server credentials (optional, improves connectivity behind strict NATs)
TURN_URL=turn:your-turn-server.com:3478
TURN_USERNAME=your-turn-user
TURN_CREDENTIAL=your-turn-password
